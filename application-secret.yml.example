# src/main/resources/application-secret.yml 로 복사해서 사용함 (git에는 올라가지 않음)
# 같은 이름의 환경변수를 지정해도 됨. 여기 없는 값은 application.yml의 로컬 기본값을 씀

spring:
  datasource:
    username: account
    password: account

# 반드시 채워야 함. 비어 있으면 서버가 뜨지 않음. openssl rand -base64 48 로 만든 값을 넣음
# 공개된 예시 값을 그대로 쓰면 누구나 토큰을 위조할 수 있으므로 예시 파일에는 값을 두지 않음
jwt:
  secret: ""

# 실제 문자를 보내려면 coolsms로 바꾸고 아래 키를 채움
# sms:
#   provider: coolsms

coolsms:
  api-key: your-coolsms-api-key
  secret-key: your-coolsms-secret-key

provider:
  phone-number: "01000000000"
